# APE environment template
# Copy to .env for local runs. Never commit real keys.

# Required for real model calls.
ZHIPU_LLM_API_KEY="your_zhipu_api_key"

# Optional provider overrides. Defaults are suitable for Zhipu GLM.
ZHIPU_LLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4/"
ZHIPU_LLM_MODEL="glm-5.1"
ZHIPU_THINKING_TYPE="disabled"
