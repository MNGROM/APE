start
if (slow charging is active) then
  :enter power-up mode;
  if (high-voltage shutdown request charging/discharging is 2 and BMS self-check counter is 0) then
    :switch to state 127;
    if (slow charging is inactive and front MCU collateral shutdown request flag is 1) then
      :switch to state 128;
      :shutdown;
      stop
    else if (slow charging is inactive) then
      :issue 2.2s timeout warning;
      :switch to state 128;
      :enter shutdown state;
      stop
    else if (slow charging is inactive and BMS self-check counter is 1) then
      :switch to state 128;
      :shutdown;
      stop
    endif
  endif
endif
end
