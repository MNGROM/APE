start
if (remote flag is 1) then
  :enter state 28;
  if (power battery discharge protection flag is 1 and SOC is 0) then
    :switch to state 46;
    if (remote flag becomes 0) then
    :shutdown;
    stop
    end if
  endif

else if (ignition switch is 2 and front MCU initialization state is 0) then
    :switch to state 12;
  if (discharge protection flag is 1 and front MCU initialization state is 1) then
    :switch to state 46;
    if (ignition switch becomes 0) then
    :shutdown;
    stop
    end if
  endif
else if (ignition switch is 2 and front MCU initialization state is 1) then
    :switch to state 20;
  if (discharge protection flag is 1 and BMS self-check counter is 3) then
    :switch to state 40;
    if (ignition switch becomes 0) then
    :shutdown;
    :reset BMS counter;
    stop
    end if
  endif

else if (ignition switch is 2 and BMS self-check counter is 1) then
    :switch to state 23;
  if (discharge protection flag is 1 and front MCU initialization state is 1) then
    :switch to state 40;
   if (ignition switch becomes 0) then
    :shutdown;
    :reset BMS counter;
    stop
    end if
  endif
else if (ignition switch is 2) then
  :switch to state 30;
  if (power battery discharge protection flag is 1 and DCDC state is 1) then
  :switch to state 35;
  if (ignition switch becomes 0) then
  :shutdown;
  :reset BMS counter;
  stop
  end if
endif
endif
end
