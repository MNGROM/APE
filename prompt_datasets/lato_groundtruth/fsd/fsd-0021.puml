          else (no)
          end if
        else (no)
        end if
      else (no)
      end if
    else (no)
    end if
  else (no)
  end if
else (no)
end if

:Entire process is monitored by watchdog timer;

if (Any anomalies?) then (yes)
  :Trigger fault-tolerant strategies;
  :Initiate immediate data uplink to ground station;
else (no)
end if

