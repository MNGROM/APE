      fork again
      :Coordinated with powertrain FADEC;
      end fork
  fork again
    :Execute tire friction detection routine;
  end fork
end if

:TCMS activates;
fork
 :Safe distance holding function;
fork again
  :Front and obstacle detection;
fork again
  :Lane departure warning system;
end fork
  :Protected by mutexes;
  :Access shared resources like CAN bus;

:Dedicated safety monitor task;
if (Completion signals from concurrent processes?) then (yes)
  :Perform comprehensive risk assessment;
  :Integrate data validated with CRC checks;
  :Generate appropriate safety control instructions;
else (no)
end if

fork
:Telemetry data asynchronously logged to ring buffer;
